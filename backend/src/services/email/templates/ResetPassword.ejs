<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FinTrack Password Reset</title>
    <%- include('styles/style.ejs') %>
  </head>
  <body>
    <div class="container">
      <h1>Reset Your Password</h1>
      <p>
        Hello <%= firstName %>, we received a request to reset your password for
        your FinTrack account.
      </p>
      <a href="<%= resetLink %>" class="button">Reset Password</a>
      <p class="footer">
        If you didn't request a password reset, you can safely ignore this
        email.
      </p>
    </div>
  </body>
</html>
