<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FinTrack Email Verification</title>
    <%- include('styles/style.ejs') %>
  </head>
  <body>
    <div class="container">
      <h1>Verify Your Email</h1>

      <p>Hello <%= firstName %>,</p>

      <p>
        Thank you for signing up for FinTrack. Please use the verification code
        below to confirm your email address:
      </p>

      <div style="text-align: center; margin: 30px 0">
        <span
          style="
            font-size: 32px;
            letter-spacing: 8px;
            font-weight: bold;
            display: inline-block;
          "
        >
          <%= verificationCode %>
        </span>
      </div>

      <p style="text-align: center; font-size: 14px; color: #888">
        This code will expire in 15 minutes.
      </p>

      <p class="footer">
        If you did not create a FinTrack account, you can safely ignore this
        email.
      </p>
    </div>
  </body>
</html>
